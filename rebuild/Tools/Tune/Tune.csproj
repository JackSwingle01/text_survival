<Project Sdk="Microsoft.NET.Sdk">

  <!-- The combat tuner: a dev tool, never shipped. It runs fights in its own processes with the
       content tables overridden in memory (ContentOverrides), and never writes a content file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Tune</AssemblyName>
    <RootNamespace>Survival.Tune</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Sim/Sim.csproj" />
  </ItemGroup>

</Project>
