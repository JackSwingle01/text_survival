// What a candidate is scored on (the user's outcome targets, rebuild-roadmap.md "Outcome targets").
//   fights        fights per scenario per candidate in the search (one generation shares its seeds)
//   reportFights  fights per scenario for the before and after tables, on seeds the search never saw
//   scenarios     name -> { setup, weapon, cond, policy }: the combat survey's setups and policies
//                 (Fights.cs lists them). Team A is the person; in an animal-only setup, the hunters.
//   bands         a scenario's metric should land in [min, max]. Metrics, as a share of fights except
//                 rounds (a mean): aDies, bKilled, aFled, bFled (B ran off the grid), aWinsOrDrivesOff
//                 (A lived, B killed or ran), bLeaves (A lived, B ran or broke off alive), rounds.
//                 Distance outside, divided by scale and times weight, is the fitness.
//                 scored false: a band today's rules cannot express. Kept, measured and reported,
//                 never scored; the note says why.
//   orders        scenarios best first on a metric; any that beats the one before it costs the excess
//   penalties     "dies stupidly": bands by another name, reported apart
//   spread        no measured scenario should end one way (aDies, bKilled, bLeaves or aFled) in more than
//                 maxShare of its fights; the excess, times weight, is fitness. exempt: scenarios that should
//                 be lopsided.
{
 "fights": 300,
 "reportFights": 1000,

 "scenarios": {
  "caribou_careful_spear": { "setup": "hunt_caribou_resting", "weapon": "wooden_spear", "policy": "careful_melee" },
  "caribou_careful_axe":   { "setup": "hunt_caribou_resting", "weapon": "ground_stone_axe", "policy": "careful_melee" },
  "caribou_careful_knife": { "setup": "hunt_caribou_resting", "weapon": "flint_knife", "policy": "careful_melee" },
  "caribou_quick_spear":   { "setup": "hunt_caribou_resting", "weapon": "wooden_spear", "policy": "quick_melee" },

  "wolf_spear": { "setup": "wolf1_aware", "weapon": "wooden_spear", "policy": "aggressive" },
  "wolf_axe":   { "setup": "wolf1_aware", "weapon": "ground_stone_axe", "policy": "aggressive" },
  "wolf_knife": { "setup": "wolf1_aware", "weapon": "flint_knife", "policy": "aggressive" },
  "wolf_crude_spear": { "setup": "wolf1_aware", "weapon": "crude_spear", "policy": "aggressive" },
  "wolf_stone": { "setup": "wolf1_aware", "weapon": "stone", "policy": "aggressive" },
  "wolf_staff": { "setup": "wolf1_aware", "weapon": "staff", "policy": "aggressive" },
  "wolf_hands": { "setup": "wolf1_aware", "weapon": "none", "policy": "aggressive" },
  "wolf_flint_axe": { "setup": "wolf1_aware", "weapon": "flint_axe", "policy": "aggressive" },
  "wolf_obsidian_knife": { "setup": "wolf1_aware", "weapon": "obsidian_knife", "policy": "aggressive" },
  "wolf_bone_knife": { "setup": "wolf1_aware", "weapon": "bone_knife", "policy": "aggressive" },

  "pack3_spear": { "setup": "pack3_aware", "weapon": "wooden_spear", "policy": "aggressive" },

  "bear_stand":  { "setup": "bear_close", "weapon": "wooden_spear", "policy": "stand_intimidate" },
  "bear_attack": { "setup": "bear_close", "weapon": "wooden_spear", "policy": "aggressive" },
  "bear_run":    { "setup": "bear_close", "weapon": "wooden_spear", "policy": "run" },
  "bear_hands":  { "setup": "bear_close", "weapon": "none", "policy": "aggressive" },
  "bear_hands_stand": { "setup": "bear_close", "weapon": "none", "policy": "stand_intimidate" },
  "bear_den_stand":  { "setup": "bear_den", "weapon": "wooden_spear", "policy": "stand_intimidate" },
  "bear_den_attack": { "setup": "bear_den", "weapon": "wooden_spear", "policy": "aggressive" },
  "bear_den_run":    { "setup": "bear_den", "weapon": "wooden_spear", "policy": "run" },

  "wolves_vs_caribou": { "setup": "wolves4_vs_caribou1_noticed" }
 },

 "bands": [
  { "name": "Careful spear hunt on caribou: meat", "scenario": "caribou_careful_spear", "metric": "bKilled", "min": 0.2, "max": 0.7,
   "note": "Was 50-70%; the floor is the user's acceptance bar for now (2026-11-22): a careful hunter kills a caribou some of the time." },
  { "name": "Quick approach on caribou: meat", "scenario": "caribou_quick_spear", "metric": "bKilled", "max": 0.2 },

  { "name": "Armed vs a lone wolf: win or drive off", "scenario": "wolf_spear", "metric": "aWinsOrDrivesOff", "min": 0.7, "max": 0.85 },
  { "name": "Armed vs a lone wolf: deaths", "scenario": "wolf_spear", "metric": "aDies", "max": 0.05 },
  { "name": "Armed vs a lone wolf: rounds", "scenario": "wolf_spear", "metric": "rounds", "min": 3, "max": 8, "scale": 10 },
  { "name": "Unarmed vs a lone wolf: deaths", "scenario": "wolf_hands", "metric": "aDies", "min": 0.25, "max": 0.35, "note": "about 30%" },

  { "name": "Pack of 3 in the open, armed: deaths", "scenario": "pack3_spear", "metric": "aDies", "min": 0.45, "max": 0.55, "note": "about 50%" },

  // Combat round 6 (2026-11-21): a healthy adult with a spear meets a surprised bear at 8 m, no cubs, no kill;
  // the bear opens in Standoff, a bluff.
  { "name": "Bear, stand and intimidate: bear leaves", "scenario": "bear_stand", "metric": "bLeaves", "min": 0.45, "max": 0.55 },
  { "name": "Bear, stand and intimidate: bear killed", "scenario": "bear_stand", "metric": "bKilled", "max": 0.05 },
  { "name": "Bear, stand and intimidate: deaths", "scenario": "bear_stand", "metric": "aDies", "min": 0.10, "max": 0.20 },
  { "name": "Bear, attack: bear leaves", "scenario": "bear_attack", "metric": "bLeaves", "max": 0.10 },
  { "name": "Bear, attack: bear killed", "scenario": "bear_attack", "metric": "bKilled", "min": 0.10, "max": 0.20 },
  { "name": "Bear, attack: deaths", "scenario": "bear_attack", "metric": "aDies", "min": 0.35, "max": 0.50 },
  { "name": "Bear, run: bear leaves", "scenario": "bear_run", "metric": "bLeaves", "max": 0.10 },
  { "name": "Bear, run: bear killed", "scenario": "bear_run", "metric": "bKilled", "max": 0.0 },
  { "name": "Bear, run: deaths", "scenario": "bear_run", "metric": "aDies", "min": 0.50, "max": 0.65,
   "note": "Running is Flee, at any distance; until the catch-up (combat round 3) it leaves the grid at once." },
  { "name": "Bear, unarmed and standing: deaths", "scenario": "bear_hands_stand", "metric": "aDies", "min": 0.25, "max": 0.35 },
  // Defending a kill or its den: 15 points more deaths in every row.
  { "name": "Bear at its den, stand: deaths", "scenario": "bear_den_stand", "metric": "aDies", "min": 0.25, "max": 0.35 },
  { "name": "Bear at its den, attack: deaths", "scenario": "bear_den_attack", "metric": "aDies", "min": 0.50, "max": 0.65 },
  { "name": "Bear at its den, run: deaths", "scenario": "bear_den_run", "metric": "aDies", "min": 0.65, "max": 0.80 }
 ],

 "orders": [
  { "name": "Weapon order against a lone wolf", "metric": "aWinsOrDrivesOff", "scenarios": ["wolf_spear", "wolf_axe", "wolf_knife", "wolf_stone", "wolf_staff", "wolf_hands"], "margin": 0.02,
   "note": "Strict: each must beat the next by 2 points, so a tie at 100% still costs. The weapon table's order." },
  // The stone, flint, obsidian and bone tools in the same order: the sharpest knife below either axe, the
  // plainest above the stone. The two axes fight alike, as do the flint and bone knives, so none is set against its
  // twin, and the spear's lead on an axe is the order above's. The obsidian knife's damage saturates about 2 points
  // under an axe (4000 fights, 2026-11-25), so its margin there is 1 point.
  { "name": "The flint axe and the obsidian knife in the weapon order", "metric": "aWinsOrDrivesOff", "scenarios": ["wolf_flint_axe", "wolf_obsidian_knife", "wolf_stone"], "margin": 0.02 },
  { "name": "The obsidian knife below the ground stone axe", "metric": "aWinsOrDrivesOff", "scenarios": ["wolf_axe", "wolf_obsidian_knife"], "margin": 0.01 },
  { "name": "The bone knife above the stone", "metric": "aWinsOrDrivesOff", "scenarios": ["wolf_bone_knife", "wolf_stone"], "margin": 0.02 },
  { "name": "A crude spear does worse than a finished one", "metric": "aWinsOrDrivesOff", "scenarios": ["wolf_spear", "wolf_crude_spear"], "margin": 0.02 },
  { "name": "Weapon order on a careful caribou hunt", "metric": "bKilled", "scenarios": ["caribou_careful_spear", "caribou_careful_axe", "caribou_careful_knife"], "margin": 0.02,
   "note": "Hands are left out: bare hands never kill a caribou." }
 ],

 // The user's acceptance bar (2026-11-22): spread outcomes. Exempt, as they should end one way: attacking a bear
 // bare-handed, and a careless approach on caribou, which its own band holds to few kills.
 "spread": { "maxShare": 0.95, "weight": 1, "exempt": ["bear_hands", "caribou_quick_spear"] },

 "penalties": [
  { "name": "A wolf killed by caribou", "scenario": "wolves_vs_caribou", "metric": "aDies", "max": 0.02, "weight": 2 },
  { "name": "A bear lost to one unarmed person", "scenario": "bear_hands", "metric": "bKilled", "max": 0.02, "weight": 2 },
  { "name": "A wolf lost to one unarmed person", "scenario": "wolf_hands", "metric": "bKilled", "max": 0.05, "weight": 2 },
  { "name": "A person killed by the caribou they stalk", "scenario": "caribou_careful_spear", "metric": "aDies", "max": 0.01, "weight": 2 }
 ]
}
