<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Survival</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The game's tables, read by Content as Survival.Content.<file>: no working-directory dependence. -->
    <EmbeddedResource Include="Content\*.json" />
  </ItemGroup>

</Project>
