// Loot tables: what a salvage holds, rolled once when generation puts it on a tile (old
// RewardGenerator pools, and SalvageFeature.CreateAbandonedCamp). A table is a list of rolls, each
// taken in order:
//   chance           odds the roll happens at all (default 1)
//   resource, kg     a resource, kg drawn uniform in [min, max] per piece; pieces [min, max] inclusive (default 1)
//   gear             one of these gear kinds, uniform; durabilityPct [min, max] of its maximum (default whole)
//   pick, of         [min, max] distinct rolls from "of", shuffled (old "roll 2-4 of these")
// Kinds and resources must name real ones; ContentTests checks.
{
 "AbandonedCamp": [
  { "resource": "Stick", "kg": [0.3, 0.3], "pieces": [2, 2] },
  { "resource": "Tinder", "kg": [0.05, 0.05] },
  { "resource": "PlantFiber", "kg": [0.1, 0.1] },
  { "chance": 0.5, "gear": ["worn_knife"] }
 ],
 // Old 40% fishing rod or net (60-90%) left out; there is no fishing gear or fishing yet.
 "AncientCache": [
  { "gear": ["bow_drill", "fire_striker", "flint_knife"], "durabilityPct": [0.8, 1.0] },
  { "chance": 0.3, "gear": ["waterskin"], "durabilityPct": [0.7, 1.0] },
  { "resource": "Tinder", "kg": [0.3, 0.6] },
  { "resource": "BirchBark", "kg": [0.1, 0.2] },
