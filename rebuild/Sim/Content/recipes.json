// How things are made (emergent-world-design §3.7; old NeedCraftingSystem, the MVP families). Loaded
// once by Content; the loader checks every name and outcome. Make.cs runs them.
//
// Each recipe, by id, in menu order:
//   name, category (MakeCategory);
//   inputs: { "of": "A|B", "kg": n } is kilos of any of those resources, taken in the order listed;
//     { "item": kind } is one piece of that gear kind, consumed into the result;
//   tools: capabilities the pack must give (each used once per finished piece); faster: capabilities
//     that speed the work when carried (optional), each by fasterBy (optional, 1.5 if not given);
//   requires: what the place must have to start and to go on (Light, Fire, Frost, Shelter, Dry,
//     NoShelter); Tent is a tent carried, checked to start, and the tent goes into the work;
//   minutes: the work for someone whole, warm and dry;
//   result: { "gear": kind } for one piece, or { "resource": r, "kg": n }; or, placed on the tile,
//     { "shelter": ShelterKind, "named": its name } (the tent carried, if it needs one) or
//     { "bedding": BeddingKind }. A placed result's project stays on the tile for anyone there to
//     go on with; its materials are used up when the work starts, and it has no outcomes;
//   outcomes: `succeed|fail[:effect:params...]=<base odds>`, one rolled per finished piece; the odds
//     left over are the plain result. Effects: waste_material:<input>:<share>,
//     save_material:<input>:<share>, extra_product:<gear or resource>:<n>, injury:<BodyTarget>:<damage>,
//     break_tool:<capability>[:<uses lost>] (no amount breaks it outright). `|` in a parameter lists
//     alternatives, the odds split evenly. An input of alternatives is named by any of them. Base odds
//     add up to at most 0.5.
// Old item counts become kilos through shelters.json's nominal pieces: a stick 0.3, plant fibre 0.1,
// a stone 0.3, sinew 0.1, a hide 1.0. Wood is Pine|Birch|Oak, from the deadfall foraging finds.
{
 // ---- cutting tools: a sharp rock needs nothing, a hammerstone knaps the rest ----
 "sharp_rock": { "name": "Sharp rock", "category": "CuttingTool",
  "inputs": [ { "of": "Stone", "kg": 0.3 } ], "tools": [], "requires": ["Light"], "minutes": 5,
  "result": { "gear": "sharp_rock" },
  "outcomes": ["fail:waste_material:Stone:1=.20", "succeed:injury:LeftArm|RightArm:0.03=.05"] },
 "hammerstone": { "name": "Hammerstone", "category": "CuttingTool",
  "inputs": [ { "of": "Stone", "kg": 0.6 } ], "tools": [], "requires": ["Light"], "minutes": 10,
  "result": { "gear": "hammerstone" },
  "outcomes": ["fail=.05"] },
 "stone_knife": { "name": "Stone knife", "category": "CuttingTool",
  "inputs": [ { "of": "Stone", "kg": 0.3 }, { "of": "Kindling", "kg": 0.3 }, { "of": "PlantFiber|Sinew", "kg": 0.1 } ],
  "tools": ["Striking"], "requires": ["Light"], "minutes": 20,
  "result": { "gear": "stone_knife" },
  "outcomes": ["fail:waste_material:Stone:1=.10", "succeed:injury:LeftArm|RightArm:0.04=.04"] },
 "flint_knife": { "name": "Flint knife", "category": "CuttingTool",
  "inputs": [ { "of": "Flint", "kg": 0.3 }, { "of": "Kindling", "kg": 0.3 }, { "of": "PlantFiber|Sinew", "kg": 0.1 } ],
  "tools": ["Striking"], "faster": ["Cutting"], "requires": ["Light"], "minutes": 25,
  "result": { "gear": "flint_knife" },
  "outcomes": ["fail:waste_material:Flint:1=.10", "succeed:injury:LeftArm|RightArm:0.05=.05", "fail:break_tool:Striking=.02",
   "succeed:extra_product:sharp_rock:1=.05"] },
 "bone_needle": { "name": "Bone needle", "category": "CuttingTool",
  "inputs": [ { "of": "Bone", "kg": 0.1 } ], "tools": ["Cutting"], "requires": ["Light"], "minutes": 20,
  "result": { "gear": "bone_needle" },
  "outcomes": ["fail:waste_material:Bone:1=.15"] },

