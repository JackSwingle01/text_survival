// How things are made (emergent-world-design §3.7; old NeedCraftingSystem, the MVP families). Loaded
// once by Content; the loader checks every name and outcome. Make.cs runs them.
//
// Each recipe, by id, in menu order:
//   name, category (MakeCategory);
//   inputs: { "of": "A|B", "count": n } is n pieces of any of those discrete resources, any piece of the kind;
//     { "of": "A|B", "g": n } is grams of any of those continuous ones; an input mixing the two forms names both
//     (count for its discrete alternatives, g for its continuous ones). Taken in the order listed, from the first
//     alternative's form if there is enough of it. A discrete input never names a weight.
//     { "item": kind } is one piece of that gear kind, consumed into the result;
//   tools: capabilities the pack must give (each used once per finished piece); faster: capabilities
//     that speed the work when carried (optional), each by fasterFactor (optional, 1.5 if not given);
//   requires: what the place must have to start and to go on (Light, Fire, Frost, Shelter, Dry,
//     NoShelter); Tent is a tent carried, checked to start, and the tent goes into the work;
//   minutes: the work for someone whole, warm and dry;
//   result: { "gear": kind } for one piece, weighing what items.json says, never more than its lightest possible
//     inputs; { "resource": r, "count": n, "sharePct": s } for n pieces of a discrete r, together s of the actual
//     weight that went in (less what an outcome wastes), each in r's range; { "resource": r, "g": n } for a
//     continuous r, or { "resource": r, "sharePct": s } for s of the actual weight that went in; or, placed on the tile,
//     { "shelter": ShelterKind, "shelterName": its name } (the tent carried, if it needs one) or
//     { "bedding": BeddingKind }. A placed result's project stays on the tile for anyone there to
//     go on with; its materials are used up when the work starts, and it has no outcomes. Or a repair,
//     { "repairs": [gear kinds], "restoresPct": s }: worked on one held piece of those kinds (taken off, if worn, and
//     put back on), restoring s of its missing condition, the materials joining its parts record; its name is the
//     verb ("Mend"), and each kind is repaired by one recipe;
//   station and driver (optional): a recipe worked by a station (StationKind) rather than a person, and what
//     drives it (StationDriver). It has one input, one piece of one discrete resource; its result is a count of 1
//     and a sharePct of that piece; minutes are its time at full rate, whatever the piece weighs; and it has no
//     tools, faster tools, items, requirements or outcomes: nothing is rolled and nothing fails;
//   outcomes: `succeed|fail[:effect:params...]=<base odds>`, one rolled per finished piece; the odds
//     left over are the plain result. Effects: waste_material:<input>:<share>,
//     save_material:<input>:<share>, extra_product:<gear or resource>:<n> (of the recipe's own discrete result, n more
//     whole pieces sharing its weight), injury:<BodyTarget>:<damage>,
//     break_tool:<capability>[:<uses lost>] (no amount breaks it outright). `|` in a parameter lists
//     alternatives, the odds split evenly. An input of alternatives is named by any of them. Base odds
//     add up to at most 0.5.
// Counts are the kilos these recipes once took, in the nominal pieces they assumed: a stick 0.3, a branch 2.0,
// a stone or flint 0.3, pyrite 0.2, bone 0.3, sinew 0.1, rope 0.2, a hide 1.0, scraped 0.8, cured 0.7 (rounded,
// at least one). Wood is PineBranch|BirchBranch|OakBranch, gathered by hand; firewood is only ever fuel.
{
 // ---- cutting tools: a crude edge needs nothing; the stone (a weapon below) knaps the rest. A binding is
 // 1 sinew or 50 g of plant fibre. A proper blade needs flint or obsidian; there is no obsidian axe ----
 "crude_edge": { "name": "Crude edge", "category": "CuttingTool",
  "inputs": [ { "of": "Stone", "count": 1 } ], "tools": [], "requires": ["Light"], "minutes": 5,
  "result": { "gear": "crude_edge" },
  "outcomes": ["fail:waste_material:Stone:1=.20", "succeed:injury:LeftArm|RightArm:0.03=.05"] },
 "flint_knife": { "name": "Flint knife", "category": "CuttingTool",
  "inputs": [ { "of": "Flint", "count": 1 }, { "of": "Stick", "count": 1 }, { "of": "PlantFiber|Sinew", "count": 1, "g": 50 } ],
  "tools": ["Striking"], "faster": ["Cutting"], "requires": ["Light"], "minutes": 25,
  "result": { "gear": "flint_knife" },
  "outcomes": ["fail:waste_material:Flint:1=.10", "succeed:injury:LeftArm|RightArm:0.05=.05", "fail:break_tool:Striking=.02",
   "succeed:extra_product:crude_edge:1=.05"] },
 // Glass knaps to a finer edge than flint, and cuts the hand that works it more often.
