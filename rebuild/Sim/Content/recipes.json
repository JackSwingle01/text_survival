 "fire_striker": { "name": "Fire striker", "category": "FireStarting",
  "inputs": [ { "of": "Flint", "kg": 0.3 }, { "of": "Pyrite", "kg": 0.2 } ], "tools": ["Striking"], "requires": ["Light"], "minutes": 10,
