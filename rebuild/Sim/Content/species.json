// Animals and people as bodies, fighters and herds (old AnimalFactory, AnimalType and the herd
// behaviours). Loaded once by Content; ContentTests checks every name in here resolves.
//
// species: every Species has one row.
//   body, weightKg, fatPct, musclePct: the body plan and its average build (members vary around it).
//   role: how it meets a threat. isSmall: small game, which runs where a big one of its role would not.
//   attackDamage, attackType: its unarmed attack. threat, boldness, aggression, cohesion: the morale
//   numbers combat runs on. moveAllowanceM: metres covered in one combat action at full Moving.
//   temperament: what makes its herd come at a target (a name in temperaments).
//   behavior: how its herd lives (old HerdBehaviorType; Carrion is the folded scavenger flock). diet: what its herd grazes (a name in diets).
//   Humans, rabbits and foxes never form herds of their own; theirs are the old defaults, Prey and Carnivore.
//   How each species runs and what it eats grazing are in Species.cs (SpeciesTable.MotionRow) until
//   the content loader takes them here.
// Every number's source is tagged by its row: V read in a primary source, R recalled from the literature
// (check before pinning a test to it), D derived or judged (documentation/species-stats-research.md).
//
// temperaments: base, a bonus per member, hunger (hungryAt, starvingAt, hungerBonus), defending a kill
//   or den (defendBonus), and a ceiling (cap). Cap 0 never starts a fight.
// diets: what each Diet takes off a tile's forage, in order (old AnimalDietExtensions.GetConsumedResources).
// sightings: how watchful a stalked animal is, by what its herd is doing; one is picked at random
//   (old HuntingSightings' DetectionModifier values, pool by pool, in their order).
{
 "species": {
  // Old Player: unarmed 0.15 blunt. Old NPC punched for 0.1; one agent model means one number.
  // The build is the baseline adult man (Body.BaselineWeightKg, BaselineFatPct, BaselineMusclePct).
  // Build R (Holt & Formicola 2008; Pontzer 2012; Janssen 2000). A woman's build is in Species.cs for now.
  "Human": { "body": "Human", "weightKg": 68, "fatPct": 0.12, "musclePct": 0.38, "role": "Human", "isSmall": false,
   "attackDamage": 0.15, "attackType": "Blunt", "threat": 1.0, "boldness": 1.0, "aggression": 1.0, "cohesion": 0.5, "moveAllowanceM": 3,
   "temperament": "never", "behavior": "Prey", "diet": "Carnivore" },
  // Mass V (Mech 1966) and R (Alaska); fat R; muscle D.
  "Wolf": { "body": "Quadruped", "weightKg": 45, "fatPct": 0.10, "musclePct": 0.48, "role": "Predator", "isSmall": false,
   "attackDamage": 0.45, "attackType": "Pierce", "threat": 0.7, "boldness": 1.3, "aggression": 0.8, "cohesion": 2, "moveAllowanceM": 6,
   "temperament": "wolf", "behavior": "Pack", "diet": "Carnivore" },
  // Brown bear. Mass R, fat R (autumn-to-spring middle), muscle D.
  "Bear": { "body": "Quadruped", "weightKg": 250, "fatPct": 0.25, "musclePct": 0.40, "role": "Predator", "isSmall": false,
   "attackDamage": 0.60, "attackType": "Sharp", "threat": 2.5, "boldness": 1.6, "aggression": 0.4, "cohesion": 0, "moveAllowanceM": 5,
   "temperament": "bear", "behavior": "Solitary", "diet": "Omnivore" },
  // A den defender, not a predator: mostly herbivorous (R, Bocherens), dangerous in or near its den (its
  // temperament: no base boldness, no hunger, all of it from defending). Mass V (Christiansen 1999, the sexes
  // between), fat R, muscle D.
  "CaveBear": { "body": "Quadruped", "weightKg": 400, "fatPct": 0.25, "musclePct": 0.40, "role": "Predator", "isSmall": false,
   "attackDamage": 0.80, "attackType": "Sharp", "threat": 3.0, "boldness": 1.8, "aggression": 0.4, "cohesion": 0, "moveAllowanceM": 4,
   "temperament": "caveBear", "behavior": "Solitary", "diet": "Omnivore" },
  // Homotherium latidens, the Eurasian scimitar-tooth (the old generic 300 kg sabre-tooth). Mass V (Illinois State
  // Museum), fat and muscle D.
  "Homotherium": { "body": "Quadruped", "weightKg": 190, "fatPct": 0.08, "musclePct": 0.48, "role": "Predator", "isSmall": false,
   "attackDamage": 0.90, "attackType": "Pierce", "threat": 3.0, "boldness": 2.0, "aggression": 0.7, "cohesion": 0, "moveAllowanceM": 7,
   "temperament": "homotherium", "behavior": "Solitary", "diet": "Carnivore" },
  // Cave hyena. Mass V/R (Wroe 2005, larger than the spotted), fat and muscle D.
  "Hyena": { "body": "Quadruped", "weightKg": 85, "fatPct": 0.10, "musclePct": 0.48, "role": "Scavenger", "isSmall": false,
   "attackDamage": 0.40, "attackType": "Blunt", "threat": 0.4, "boldness": 0.7, "aggression": 0.5, "cohesion": 2, "moveAllowanceM": 6,
   "temperament": "hyena", "behavior": "Scavenger", "diet": "Carnivore" },
  // Mass R, fat R (late winter to autumn middle), muscle D.
  "Caribou": { "body": "Quadruped", "weightKg": 110, "fatPct": 0.08, "musclePct": 0.47, "role": "Prey", "isSmall": false,
   "attackDamage": 0.25, "attackType": "Blunt", "threat": 0.3, "boldness": 0.3, "aggression": 0.05, "cohesion": 1, "moveAllowanceM": 3,
   "temperament": "never", "behavior": "Prey", "diet": "Browser" },
  // Mass V (summaries); fat and muscle D, by red deer and elk.
  "Megaloceros": { "body": "Quadruped", "weightKg": 550, "fatPct": 0.12, "musclePct": 0.45, "role": "DangerousPrey", "isSmall": false,
   "attackDamage": 0.50, "attackType": "Blunt", "threat": 0.5, "boldness": 0.4, "aggression": 0.1, "cohesion": 1, "moveAllowanceM": 3,
   "temperament": "never", "behavior": "Prey", "diet": "Browser" },
  // Steppe bison, the herd's average (bulls 850, cows 500). Mass V (summaries), fat and muscle D.
  "Bison": { "body": "Quadruped", "weightKg": 600, "fatPct": 0.12, "musclePct": 0.45, "role": "DangerousPrey", "isSmall": false,
   "attackDamage": 0.55, "attackType": "Pierce", "threat": 1.8, "boldness": 0.5, "aggression": 0.1, "cohesion": 2, "moveAllowanceM": 3,
   "temperament": "never", "behavior": "Prey", "diet": "Grazer" },
  // A family group's average (bulls 6 t, cows 4 t; R, check Larramendi 2016). Fat V/R (an 8 cm layer), muscle D.
  "Mammoth": { "body": "Quadruped", "weightKg": 5000, "fatPct": 0.10, "musclePct": 0.40, "role": "DangerousPrey", "isSmall": false,
   "attackDamage": 1.2, "attackType": "Pierce", "threat": 3.5, "boldness": 1.0, "aggression": 0.1, "cohesion": 2, "moveAllowanceM": 3,
   "temperament": "never", "behavior": "Prey", "diet": "Browser" },
  // The mountain hare. Mass R, fat and muscle D.
  "Rabbit": { "body": "Quadruped", "weightKg": 3, "fatPct": 0.05, "musclePct": 0.50, "role": "Prey", "isSmall": true,
   "attackDamage": 0.02, "attackType": "Blunt", "threat": 0.05, "boldness": 0.1, "aggression": 0.0, "cohesion": 1, "moveAllowanceM": 3,
   "temperament": "never", "behavior": "Prey", "diet": "Carnivore" },
  // Mass R, fat and muscle D.
  "Fox": { "body": "Quadruped", "weightKg": 6, "fatPct": 0.10, "musclePct": 0.45, "role": "Scavenger", "isSmall": true,
   "attackDamage": 0.12, "attackType": "Pierce", "threat": 0.15, "boldness": 0.4, "aggression": 0.1, "cohesion": 0, "moveAllowanceM": 3,
   "temperament": "never", "behavior": "Prey", "diet": "Carnivore" },
  // The folded scavenger (Species.Raven): ravens, a fox, a wolverine as one flock, each member about
  // a fox's build at a raven's weight (judgment). It never starts a fight and runs from one. Between
  // kills it forages like a bear for berries, fungi and roots (Omnivore), so it never starves.
  // Fat and muscle D.
  "Raven": { "body": "Quadruped", "weightKg": 3, "fatPct": 0.10, "musclePct": 0.45, "role": "Scavenger", "isSmall": true,
   "attackDamage": 0.05, "attackType": "Pierce", "threat": 0.05, "boldness": 0.3, "aggression": 0.0, "cohesion": 1, "moveAllowanceM": 6,
   "temperament": "never", "behavior": "Carrion", "diet": "Omnivore" }
 },

