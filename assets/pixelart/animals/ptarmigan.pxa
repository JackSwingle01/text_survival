// Ptarmigan in winter plumage. Drawn side-on as a whole bird - a bird's
// head alone at this size is just a dot with a beak. Outline is kept dark
// so a white bird still reads against snow.
SIZE 16x16
PALETTE
. = #00000000
o = #3a3a44
W = #f0f2f4
e = #1a1a1e
k = #2a2a2e
f = #7a6a4a
