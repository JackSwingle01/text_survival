// Fishing net: a gill-net panel strung between two ropes, with floats above.
// The mesh is offset single pixels forming a diamond lattice - it stays
// 8-connected, so CONNECTED still holds.
SIZE 16x16
PALETTE
. = #00000000
o = #4a3728
n = #8a7355
f = #ddd6c4
PIXELS
................
................
...f...f...f....
..oooooooooooo..
..n.n.n.n.n.n...
...n.n.n.n.n.n..
..n.n.n.n.n.n...
...n.n.n.n.n.n..
..n.n.n.n.n.n...
...n.n.n.n.n.n..
..oooooooooooo..
................
................
................
................
................

CHECKS
  CONNECTED
ENDCHECKS
