// A pair of crossed bones. Left half is a ">" chevron with knobbed ends;
// MIRRORX crosses it. The shadow tone is what keeps white bone visible
// against snow.
SIZE 16x16
PALETTE
. = #00000000
B = #ede6d4
b = #9c917a
PIXELS
................
................
................
Bb..............
BBb.............
.BBb............
..Bb............
...Bb...........
....Bb..........
.....BBb........
....Bb..........
...Bb...........
..Bb............
.BBb............
BBb.............
Bb..............
MIRRORX

CHECKS
  CONNECTED
ENDCHECKS
