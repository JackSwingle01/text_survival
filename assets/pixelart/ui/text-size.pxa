// Large and small type glyphs are intentionally separate; each glyph is connected.
SIZE 16x16
PALETTE
. = #00000000
o = #292832
b = #70b7ce
w = #d5ece4
s = #36718e
PART large 8x13
RECT 0 0 8 4 o
RECT 2 3 4 10 o
RECT 1 1 6 2 w
RECT 3 3 2 9 b
LINE 4 4 4 11 s
ENDPART
PART small 5x8
RECT 0 0 5 3 o
RECT 1 2 3 6 o
RECT 1 1 3 1 w
RECT 2 2 1 5 b
ENDPART
COMPOSE
PLACE large AT 1 1
PLACE small AT 10 6
ENDCOMPOSE
CHECKS
CONNECTED large
CONNECTED small
ENDCHECKS
