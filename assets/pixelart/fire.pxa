SIZE 16x16
PALETTE
. = #00000000
g = #4a3728
h = #6b4f37
r = #c62828
o = #f57c00
y = #ffca28

PART flame 8x7
  PIXEL 3 0 y
  PIXEL 3 1 y
  PIXEL 2 1 o
  PIXEL 2 2 o
  PIXEL 3 2 y
  RECT 2 3 2 2 o
  PIXEL 1 3 r
  PIXEL 1 4 r
  RECT 0 5 4 1 r
  PIXEL 2 5 o
  PIXEL 3 5 o
  RECT 1 6 3 1 r
  MIRRORX
ENDPART

PART logs 10x3
  RECT 0 0 10 1 h
  RECT 1 1 8 2 g
ENDPART

COMPOSE
  PLACE flame CENTERED
  STACK logs BELOW flame CENTERED OVERLAP 1
ENDCOMPOSE

CHECKS
  TOUCHES flame logs
  CONNECTED
ENDCHECKS
