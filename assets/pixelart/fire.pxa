// Campfire. Flame and logs are separate parts; STACK guarantees they meet.
// Fire carries no dark outline (it glows) - heat gradient instead:
// deep red edge -> orange -> yellow -> white-hot core at the base of the flame.
SIZE 16x16
PALETTE
. = #00000000
r = #d13b1f
o = #f5811f
y = #ffc93c
w = #fff3c4
k = #2b1f14
g = #55402a
h = #7a5a3a

PART flame 16x11
  GRID
  .......y........
  ......yy........
  ......oy........
  .....roy........
  .....roy........
  ....rooy........
  ....royw........
  ...rooyw........
  ..rrooyw........
  ..rrooyw........
  ...rrooy........
  MIRRORX
ENDPART

PART logs 16x4
  GRID
  ..khhhhh........
  .kgggggg........
  .kgggggg........
  ..kkkkkk........
  MIRRORX
ENDPART

COMPOSE
  PLACE flame AT 0 1
  STACK logs BELOW flame CENTERED
ENDCOMPOSE

CHECKS
  TOUCHES flame logs
  CONNECTED
ENDCHECKS
